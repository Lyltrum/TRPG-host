# development | production | test
APP_ENV=development

# 本地默认用 SQLite 即可跑通全流程；生产切换为 PostgreSQL 异步驱动
DATABASE_URL=sqlite+aiosqlite:///./app.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/trpg

# 是否开启 /docs /redoc /openapi.json，本地开发默认开启
ENABLE_DOCS=true

LOG_LEVEL=INFO

# JSON 数组格式
CORS_ORIGINS=["http://localhost:9877"]

# 局域网开局：默认 true，额外放行私有网段（10./172.16-31./192.168./127.）的任意
# 端口，朋友从 http://<你的局域网IP>:9877 打开才连得上后端。设 false 只认上面
# 那张显式清单。后端还要用 --host 0.0.0.0 启动，否则外面根本连不进来。
# CORS_ALLOW_PRIVATE_NETWORK=true

# 不配则 AI 主持人叙事回退到确定性占位文案（CI/e2e 默认如此）；配了走真实 DeepSeek
# DEEPSEEK_API_KEY=

# ── 模型与超时（都有默认值，不配就用默认）──
# 对局这条链用哪个模型。一个键管全部：裁决 / 叙事 / AI 玩家 / 装备审核 /
# 复盘 / 章节摘要。默认 deepseek-v4-flash；要更好的叙事质量可换 deepseek-v4-pro
# （贵得多，而对局一天能烧几百次调用）。
# 🔴 模组导入**不走这个键**，那条线自己一份常量。
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 六处超时各一个键，**本来就该是六个不同的数**：一次裁决要跑完整条两阶段链，
# 而 AI 玩家只是判一句"要不要接话"。括号里是默认值。
# DEEPSEEK_TIMEOUT_SECONDS=30          （简单叙事）
# KEEPER_TIMEOUT_SECONDS=60            （裁决 / 主叙事链）
# AI_ACTOR_TIMEOUT_SECONDS=25          （AI 玩家决定要不要接话）
# EQUIPMENT_CHECK_TIMEOUT_SECONDS=40   （建卡时的装备合理性审核）
# CHAPTER_TIMEOUT_SECONDS=40           （L2 章节摘要，离线写）
# RECAP_TIMEOUT_SECONDS=30             （局末复盘）

# 一个账号一天能发多少次 LLM 调用（app/core/llm_quota.py）。默认 500 的定位是
# 「接上了但不挡路」；跑记忆实验/批量脚本那种一天几百拍的用法要调高。
# 配 0 或负数 = 显式关掉这道闸门。
# LLM_DAILY_CALL_QUOTA=500

# ── keeper agent 实验（feat/keeper-agent 分支）──
# 结构化剧本 JSON 的路径（相对 trpg-backend 目录）。与 DEEPSEEK_API_KEY 同时
# 配置时，AI 主持人切换为真正的守秘人 agent（掷骰/角色卡/剧本/状态/HP/San
# 六工具）。剧本文件因版权 gitignore，需本地自备。
# KEEPER_MODULE_PATH=../模组资料/追书人.structured.json
# keeper 一轮回应含多跳工具调用（30-90s），锁超时建议放宽到 180
# ACTION_LOCK_TIMEOUT_SECONDS=180
