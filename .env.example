# docker-compose 用的配置。复制成 .env 再改：cp .env.example .env
#
# 🔴 .env 不进 git（里面有数据库密码和 API key）。

# ── 数据库 ──────────────────────────────────────────────
POSTGRES_USER=aidm
POSTGRES_DB=aidm
# 必填，没有默认值——compose 会直接拒绝启动而不是给你一个弱密码。
POSTGRES_PASSWORD=

# ── 对外端口 ────────────────────────────────────────────
# 浏览器访问 http://<这台机器的地址>:8080
WEB_PORT=8080

# ── AI ──────────────────────────────────────────────────
# 不配的话叙事会退回确定性占位文案（能跑通流程，但不是真的 AI 主持）。
DEEPSEEK_API_KEY=

# 🔴 一个账号一个 UTC 日历日能发多少次 LLM 调用。
# 默认 500 是「接上了但不挡路」：闸门每次调用都真的走一遍，只是这个数高到
# 自己开发测试撞不到。
#
# 🔴 实测口径（2026-08-17 真机跑《复足》24 拍）：**约 2.1 次调用/拍**，
# 一局 34 拍 ≈ 70 次。此前这里写的「约 200 次」是拍脑袋估的，高了近三倍。
# 按实测，500 够一个人一天跑七局。内测时按人头算：60 大约是一局多一点。
# **内测时把它调小**，比如 60——这是唯一会真金白银出血的开关。
# 配 0 = 显式关闭闸门（跑批量脚本时用）。
LLM_DAILY_CALL_QUOTA=500

# ── 其他 ────────────────────────────────────────────────
# 守秘人一拍要跑多跳 LLM 调用，真机撞到过单拍 229 秒。
ACTION_LOCK_TIMEOUT_SECONDS=180

# 生产默认关掉 /docs、/redoc。
ENABLE_DOCS=false

# 同源部署下浏览器不发跨域请求，留空即可。
# 要让别的域名直连后端时再填，形如 ["https://example.com"]
CORS_ORIGINS=[]

# ── HTTPS（只有叠加 docker-compose.https.yml 时才用得到）──────
# 真实域名，且 A 记录已经指向这台机器。证书签给域名，**不签给 IP**。
# 本地验收可以填 localhost（Caddy 会用内部 CA 签一张本地证书）。
AIDM_DOMAIN=

# 想收「证书快到期」的提醒邮件的话，不是填这里——Caddyfile 里那条 email
# 指令不能靠空环境变量传（空值会让 Caddy 拒绝启动）。去
# trpg-frontend/Caddyfile 里把那两行注释去掉、直接写邮箱。
